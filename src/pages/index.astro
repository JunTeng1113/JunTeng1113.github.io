---
// The landing page is hidden: `/` immediately sends visitors to `/about/`.
// GitHub Pages has no HTTP redirect, so this file is a meta-refresh +
// location.replace page (with a noscript link as fallback).
import SITE from "@/config";
import { url } from "@/utils/url";

const dest = url("/about/");
const canonical = Astro.site ? new URL(dest, Astro.site).href : dest;
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={canonical} />
    <title>{SITE.title}</title>
    <script is:inline define:vars={{ dest }}>
      location.replace(dest);
    </script>
  </head>
  <body>
    <p><a href={dest}>前往關於</a></p>
  </body>
</html>
